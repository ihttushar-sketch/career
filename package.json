{
  "name": "tushar-thinking-universe",
  "version": "0.1.0",
  "private": true,
  "description": "Tushar Thinking Universe \u2014 one thinker, many worlds, 50 concepts per node.",
  "scripts": {
    "dev": "NEXT_DIST_DIR=.next-dev next dev -H 0.0.0.0 -p 3000",
    "build": "node scripts/check-content.mjs && next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "content": "node scripts/build-content.mjs",
    "check": "node scripts/check-content.mjs",
    "check:strict": "node scripts/check-content.mjs --strict",
    "test": "node --test tests/*.test.mjs",
    "index": "node scripts/build-index.mjs",
    "link-assets": "node scripts/link-assets.mjs"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "marked": "^12.0.2",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
